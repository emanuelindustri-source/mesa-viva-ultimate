{
  "name": "@mesa-viva/client",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Portal web y aplicación jugable de Mesa Viva (Preact + Vite + Capacitor)",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-brand-assets.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "generate:brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@mesa-viva/core": "workspace:*",
    "@mesa-viva/design-system": "workspace:*",
    "@mesa-viva/engine-25d": "workspace:*",
    "@mesa-viva/sensory-engine": "workspace:*",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.14.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.73.0",
    "peerjs": "^1.5.5",
    "preact": "^10.27.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
